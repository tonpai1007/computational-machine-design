# MDIE Environment Variables Configuration
# Copy this file to .env and insert your API keys as desired.

# LLM Providers (Optional - MDIE automatically operates fully offline if none are provided)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Local Ollama (Optional)
# OLLAMA_HOST=http://localhost:11434

# Provider Priority (Optional comma-separated list, e.g. groq,openrouter,gemini)
# MDIE_LLM_PROVIDER=groq,openrouter,gemini
